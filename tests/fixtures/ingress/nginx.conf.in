worker_processes 1;
pid @BASE@/nginx.pid;
error_log @BASE@/nginx-error.log warn;
events { worker_connections 128; }
http {
    access_log off;
    map $http_origin $fixture_origin_ok {
        default 0;
        "http://gascity.example.test" 1;
    }
    map $http_sec_fetch_site $fixture_fetch_ok {
        default 0;
        "same-origin" 1;
    }
    map $request_uri $fixture_forwarded_uri {
        default $request_uri;
        ~^(?<fixture_path>[^?]+)\?(?<fixture_query>.*)$ $fixture_path%3F$fixture_query;
    }
    map "$request_method:$fixture_origin_ok:$fixture_fetch_ok" $fixture_mutation_denied {
        default 0;
        ~^(POST|PUT|PATCH|DELETE):1:1$ 0;
        ~^(POST|PUT|PATCH|DELETE): 1;
    }
    server {
        listen 127.0.0.1:@RELAY_PORT@ default_server;
        server_name _;
        allow 127.0.0.1;
        deny all;
        return 421;
    }
    server {
        listen 127.0.0.1:@RELAY_PORT@;
        server_name gascity.example.test;
        allow 127.0.0.1;
        deny all;
        location = /_auth {
            internal;
            proxy_pass http://127.0.0.1:@TINYAUTH_PORT@/api/auth/nginx;
            proxy_pass_request_body off;
            proxy_set_header Content-Length "";
            proxy_set_header Host gascity.example.test;
            proxy_set_header Cookie $http_cookie;
            proxy_set_header X-Forwarded-Host gascity.example.test;
            proxy_set_header X-Forwarded-Port 80;
            proxy_set_header X-Forwarded-Proto http;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-Uri $fixture_forwarded_uri;
        }
        location = /login {
            proxy_pass http://127.0.0.1:@TINYAUTH_PORT@;
            proxy_set_header Host gascity.example.test;
            proxy_set_header X-Forwarded-Host gascity.example.test;
            proxy_set_header X-Forwarded-Port 80;
            proxy_set_header X-Forwarded-Proto http;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Real-IP $remote_addr;
        }
        location ^~ /api/user/ {
            proxy_pass http://127.0.0.1:@TINYAUTH_PORT@;
            proxy_set_header Host gascity.example.test;
            proxy_set_header Cookie $http_cookie;
            proxy_set_header X-Forwarded-Host gascity.example.test;
            proxy_set_header X-Forwarded-Port 80;
            proxy_set_header X-Forwarded-Proto http;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Real-IP $remote_addr;
        }
        location = /__fixture/sse {
            auth_request /_auth;
            auth_request_set $fixture_auth_location $upstream_http_x_tinyauth_location;
            error_page 401 = @tinyauth_login;
            proxy_pass http://127.0.0.1:@HELPER_PORT@/fixture-sse;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Last-Event-ID $http_last_event_id;
            proxy_buffering off;
            proxy_read_timeout 5s;
            add_header X-D2B-SSE-Buffering off always;
        }
        location / {
            auth_request /_auth;
            auth_request_set $fixture_auth_location $upstream_http_x_tinyauth_location;
            error_page 401 = @tinyauth_login;
            if ($fixture_mutation_denied) { return 403; }
            proxy_pass http://127.0.0.1:@SUPERVISOR_PORT@;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Port 80;
            proxy_set_header X-Forwarded-Proto http;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header Origin $http_origin;
            proxy_set_header Sec-Fetch-Site $http_sec_fetch_site;
            proxy_set_header X-GC-Request $http_x_gc_request;
            proxy_set_header Last-Event-ID $http_last_event_id;
            proxy_buffering off;
            proxy_read_timeout 60s;
            add_header X-D2B-Relay-Buffering off always;
        }
        location @tinyauth_login {
            return 302 $fixture_auth_location;
        }
    }
}
