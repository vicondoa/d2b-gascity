+
@@ -145 +151 @@ func (p *Provider) Start(ctx context.Context, name string, cfg runtime.Config) e
-	// clearSentinel removes the reservation on failure.
+	// clearSentinel removes the reservation and identity sidecars on failure.
@@ -148,0 +155 @@ func (p *Provider) Start(ctx context.Context, name string, cfg runtime.Config) e
+			p.cleanupMetaKeys(name, sentinel.startupMetaKeys)
@@ -229 +236,18 @@ func (p *Provider) Start(ctx context.Context, name string, cfg runtime.Config) e
-	if err := cmd.Start(); err != nil {
+	// Seed only the identity metadata that the reconciler uses to match a live
+	// runtime to its pending create. Keep the writes under the provider lock so
+	// Stop cannot remove the sentinel or install a replacement between the
+	// ownership check and process creation.
+	p.mu.Lock()
+	if p.conns[name] != sentinel {
+		p.mu.Unlock()
+		stderrW.Close() //nolint:errcheck
+		return fmt.Errorf("session %q was stopped during startup", name)
+	}
+	var seedErr error
+	sentinel.startupMetaKeys, seedErr = p.seedIdentityMeta(name, cfg.Env)
+	var startErr error
+	if seedErr == nil {
+		startErr = cmd.Start()
+	}
+	p.mu.Unlock()
+	if seedErr != nil {
@@ -232 +256,6 @@ func (p *Provider) Start(ctx context.Context, name string, cfg runtime.Config) e
-		return fmt.Errorf("starting session %q: %w", name, err)
+		return fmt.Errorf("seeding identity metadata for %q: %w", name, seedErr)
+	}
+	if startErr != nil {
+		stderrW.Close() //nolint:errcheck
+		clearSentinel()
+		return fmt.Errorf("starting session %q: %w", name, startErr)
@@ -436,0 +466,3 @@ func (p *Provider) Stop(name string) error {
+		if sc.cmd == nil {
+			p.cleanupMetaKeys(name, sc.startupMetaKeys)
+		}
@@ -651,0 +684,21 @@ func (p *Provider) SetMeta(name, key, value string) error {
+func (p *Provider) seedIdentityMeta(name string, env map[string]string) ([]string, error) {
+	var seeded []string
+	for _, key := range startupIdentityMetaKeys {
+		value := env[key]
+		if value == "" {
+			continue
+		}
+		if err := p.SetMeta(name, key, value); err != nil {
+			return seeded, fmt.Errorf("writing %s: %w", key, err)
+		}
+		seeded = append(seeded, key)
+	}
+	return seeded, nil
+}
+
+func (p *Provider) cleanupMetaKeys(name string, keys []string) {
+	for _, key := range keys {
+		_ = p.RemoveMeta(name, key)
+	}
+}
+
diff --git a/internal/runtime/acp/acp_test.go b/internal/runtime/acp/acp_test.go
index 9ec29931a..fce6ee408 100644
--- a/internal/runtime/acp/acp_test.go
+++ b/internal/runtime/acp/acp_test.go
@@ -205,0 +206,82 @@ func TestStart_HandshakeTimeout(t *testing.T) {
+func TestStart_SeedsIdentityMetadataBeforeHandshakeCompletes(t *testing.T) {
+	dir := filepath.Join(shortTempDir(t), "acp")
+	p := NewProviderWithDir(dir, Config{
+		HandshakeTimeout: 500 * time.Millisecond,
+	})
+	name := testName()
+	startDone := make(chan error, 1)
+	startFinished := make(chan struct{})
+	go func() {
+		defer close(startFinished)
+		startDone <- p.Start(context.Background(), name, runtime.Config{
+			Command: "sleep 300",
+			Env: map[string]string{
+				"GC_SESSION_ID":     "session-id",
+				"GC_INSTANCE_TOKEN": "instance-token",
+				"GC_RUNTIME_EPOCH":  "7",
+				"UNRELATED_ENV":     "must-not-be-seeded",
+			},
+		})
+	}()
+	t.Cleanup(func() {
+		_ = p.Stop(name)
+		select {
+		case <-startFinished:
+		case <-time.After(3 * time.Second):
+			t.Error("Start did not finish during cleanup")
+		}
+	})
+
+	deadline := time.Now().Add(2 * time.Second)
+	for !p.socketAlive(name) && time.Now().Before(deadline) {
+		select {
+		case err := <-startDone:
+			t.Fatalf("Start returned before the control socket became live: %v", err)
+		default:
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+	if !p.socketAlive(name) {
+		t.Fatal("control socket did not become live while Start was blocked")
+	}
+	select {
+	case err := <-startDone:
+		t.Fatalf("Start returned before metadata could be observed: %v", err)
+	default:
+	}
+
+	for key, want := range map[string]string{
+		"GC_SESSION_ID":     "session-id",
+		"GC_INSTANCE_TOKEN": "instance-token",
+		"GC_RUNTIME_EPOCH":  "7",
+	} {
+		got, err := p.GetMeta(name, key)
+		if err != nil {
+			t.Fatalf("GetMeta(%s): %v", key, err)
+		}
+		if got != want {
+			t.Errorf("GetMeta(%s) = %q, want %q", key, got, want)
+		}
+	}
+	if got, err := p.GetMeta(name, "UNRELATED_ENV"); err != nil {
+		t.Fatalf("GetMeta(UNRELATED_ENV): %v", err)
+	} else if got != "" {
+		t.Errorf("GetMeta(UNRELATED_ENV) = %q, want empty", got)
+	}
+
+	if err := <-startDone; err == nil {
+		t.Fatal("Start succeeded for a non-handshaking process")
+	}
+	for key := range map[string]struct{}{
+		"GC_SESSION_ID":     {},
+		"GC_INSTANCE_TOKEN": {},
+		"GC_RUNTIME_EPOCH":  {},
+	} {
+		if got, err := p.GetMeta(name, key); err != nil {
+			t.Fatalf("GetMeta(%s) after failed Start: %v", key, err)
+		} else if got != "" {
+			t.Errorf("GetMeta(%s) after failed Start = %q, want empty", key, got)
+		}
+	}
+}
+
